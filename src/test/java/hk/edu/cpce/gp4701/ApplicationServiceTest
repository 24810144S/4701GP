package hk.edu.cpce.gp4701.application.service;

import hk.edu.cpce.gp4701.application.ApplicationRepository;
import hk.edu.cpce.gp4701.application.ApplicationService;
import hk.edu.cpce.gp4701.model.Account;
import hk.edu.cpce.gp4701.model.AdmissionApplication;
import hk.edu.cpce.gp4701.model.Programme;
import hk.edu.cpce.gp4701.model.ProgrammeLevel;
import hk.edu.cpce.gp4701.model.repository.ProgrammeLevelRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.time.LocalDateTime;
import java.time.ZoneId;
import java.util.Collections;
import java.util.Optional;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
public class ApplicationServiceTest {

    @Mock
    private ApplicationRepository applicationRepository;

    @Mock
    private ProgrammeLevelRepository programmeLevelRepository;

    @InjectMocks
    private ApplicationService applicationService;

    private Account mockMember;
    private ProgrammeLevel mockProgrammeLevel;
    private Programme mockProgramme;

    @BeforeEach
    void setUp() {
        mockMember = new Account();
        mockMember.setId(101L);
        mockMember.setEmail("applicant@test.com");
        mockMember.setFullName("Tsai Hiu Lung");

        mockProgramme = new Programme();
        mockProgramme.setId(1L);
        mockProgramme.setName("HKDSE Programme");

        mockProgrammeLevel = new ProgrammeLevel();
        mockProgrammeLevel.setId(201L);
        mockProgrammeLevel.setProgramme(mockProgramme);
        mockProgrammeLevel.setLevel(1);
    }

    @Test
    void submitApplication_Success() throws Exception {
        LocalDateTime futureDeadline = LocalDateTime.now(ZoneId.of("Asia/Hong_Kong")).plusDays(10);
        mockProgramme.setApplicationDeadline(futureDeadline);

        when(programmeLevelRepository.findAll()).thenReturn(Collections.singletonList(mockProgrammeLevel));
        when(applicationRepository.existsByMemberIdAndProgrammeLevelId(101L, 201L)).thenReturn(false);
        when(applicationRepository.save(any(AdmissionApplication.class))).thenAnswer(invocation -> invocation.getArgument(0));

        AdmissionApplication result = applicationService.submitApplication(mockMember, 1L, 1);

        assertNotNull(result);
        assertEquals(101L, result.getMemberId());
        assertEquals(mockProgrammeLevel, result.getProgrammeLevel());
        assertNull(result.getDecision());
    }

    @Test
    void submitApplication_ThrowsException_WhenDeadlinePassed() {
        LocalDateTime pastDeadline = LocalDateTime.now(ZoneId.of("Asia/Hong_Kong")).minusDays(1);
        mockProgramme.setApplicationDeadline(pastDeadline);

        when(programmeLevelRepository.findAll()).thenReturn(Collections.singletonList(mockProgrammeLevel));

        IllegalStateException exception = assertThrows(IllegalStateException.class, () -> {
            applicationService.submitApplication(mockMember, 1L, 1);
        });

        assertTrue(exception.getMessage().contains("deadline for this program has passed"));
        verify(applicationRepository, never()).save(any(AdmissionApplication.class));
    }
}
